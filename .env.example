# --- App ---
NODE_ENV=development
PORT=3000

# --- Database (used by API + Worker + Prisma CLI) ---
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public

# Separate DB used only by the integration test suite (kept isolated from dev data)
DATABASE_URL_TEST=postgresql://taskflow:taskflow@localhost:5432/taskflow_test?schema=public

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---
JWT_ACCESS_SECRET=change_me_access_secret_please_rotate
JWT_REFRESH_SECRET=change_me_refresh_secret_please_rotate
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# --- Security ---
BCRYPT_COST_FACTOR=12

# --- Email (mocked, no real provider needed) ---
EMAIL_FROM=notifications@taskflow.dev
